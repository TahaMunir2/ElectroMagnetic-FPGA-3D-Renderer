# Build/output directories
/build/
/.Xil/

# Python/Jupyter local output
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Vivado generated output
vivado_project/*.jou
vivado_project/*.log
vivado_project/*.str
vivado_project/*.backup.*
vivado_project/.Xil/
vivado_project/ray_renderer.cache/
vivado_project/ray_renderer.gen/
vivado_project/ray_renderer.hw/
vivado_project/ray_renderer.ip_user_files/
vivado_project/ray_renderer.runs/
vivado_project/ray_renderer.sim/
vivado_project/ray_renderer.srcs/sources_1/bd/

# Generated D1S48 Vivado project
D1S48/vivado_project_d1s48/
D1S48/vivado_project_d1s48_camera/

# Keep the hand-maintained Vivado project entry point and known IP configuration
# files. Generated block designs, runs, caches, and duplicate IP experiments stay
# ignored.
!vivado_project/ray_renderer.xpr
!vivado_project/ray_renderer.srcs/
vivado_project/ray_renderer.srcs/**
!vivado_project/ray_renderer.srcs/sources_1/
!vivado_project/ray_renderer.srcs/sources_1/ip/
!vivado_project/ray_renderer.srcs/sources_1/ip/clk_wiz_0/
!vivado_project/ray_renderer.srcs/sources_1/ip/clk_wiz_0/clk_wiz_0.xci
!vivado_project/ray_renderer.srcs/sources_1/ip/rgb2dvi_0/
!vivado_project/ray_renderer.srcs/sources_1/ip/rgb2dvi_0/rgb2dvi_0.xci

