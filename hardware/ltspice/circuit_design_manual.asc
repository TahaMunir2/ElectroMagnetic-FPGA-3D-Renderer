TEXT -480 -384 Left 3 ;EE2 ESP32 input front-end -- complete circuit
TEXT -480 -348 Left 2 ;Nets are named by ESP32 GPIO number.  VDD3V3 = buffered 3.3 V rail.  Models auto-included via symbol ModelFile (no .include).
TEXT -400 -224 Left 2 ;POWER -> VDD3V3
TEXT -400 -200 Left 1 ;5 V -> 18k / 33k (~3.24 V) -> U1 unity follower
TEXT 152 -224 Left 2 ;CONTROL POTS -> ADC GPIOs
TEXT 152 -200 Left 1 ;wiper fraction = .param wiper ; top = {rt}, bottom = {rb}
TEXT 152 -132 Left 1 ;YAW 39
TEXT 344 -132 Left 1 ;PITCH 27
TEXT 536 -132 Left 1 ;ZOOM 14
TEXT 728 -132 Left 1 ;ZSCALE 13
TEXT 920 -132 Left 1 ;AMP 4
TEXT 1112 -132 Left 1 ;COND 15
TEXT 1304 -132 Left 1 ;FIELD 36
TEXT -480 320 Left 2 ;MODE-1 SHEET + PROBE -> GPIO34
TEXT -480 344 Left 1 ;centre +5 V, edges GND ; V(PROBE)=5*(1-FRAC) ; U2 buffer ; 18k/33k ; Rpd 10M anti-float
TEXT 400 320 Left 2 ;MODE / 2D-3D ENCODER -> GPIO35
TEXT 400 344 Left 1 ;V(35) = (2*MODE + DISP) / 3 x VDD3V3
TEXT 700 372 Left 1 ;STATE 0: Mode1 / 2D    STATE 1: Mode2 / 3D
TEXT 880 320 Left 2 ;TOUCH PANELS (MCU-driven)
TEXT 880 344 Left 1 ;Panel 1 (Mode 1): X+ 32   Y+ 33   X- 23   Y- 22
TEXT 880 720 Left 1 ;Panel 2 (Mode 2): X+ 25   Y+ 26   X- 21   Y- 19
TEXT -480 716 Left 2 ;WALL SWITCH (GPIO5) + CLEAR BUTTON (GPIO18)
TEXT -480 740 Left 1 ;pull-ups to VDD3V3 ; idle HIGH, active LOW
TEXT -480 1180 Left 2 !.op
TEXT -480 1212 Left 2 !.param wiper=0.5 RSHEET=100k FRAC=0.5
TEXT -480 1244 Left 2 !.param rt=10k*(1-wiper) rb=10k*wiper rsc=RSHEET*FRAC rse=RSHEET*(1-FRAC)
