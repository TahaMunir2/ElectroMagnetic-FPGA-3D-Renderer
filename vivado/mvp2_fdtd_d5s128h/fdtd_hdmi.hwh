  <MODULES>
    <MODULE COREREVISION="31" FULLNAME="/axi_gpio_cam_a" HWVERSION="2.0" INSTANCE="axi_gpio_cam_a" IPTYPE="PERIPHERAL" IS_ENABLE="1" MODCLASS="PERIPHERAL" MODTYPE="axi_gpio" VLNV="xilinx.com:ip:axi_gpio:2.0">
